<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical host: 301-redirect www.* → non-www, preserving scheme and path.
    # Keeps all link equity on a single hostname and avoids duplicate-content
    # SEO issues. Skips localhost / raw IP for dev convenience.
    # Path comes from THE_REQUEST, not REQUEST_URI: the hosting maps the
    # domain into /domains/namasteyoga.cz/ internally, and REQUEST_URI
    # leaks that prefix into the redirect target.
    RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^\d+\.\d+\.\d+\.\d+(:\d+)?$
    RewriteCond %{HTTP_HOST}#%{THE_REQUEST} ^www\.([^#]+)#\S+\s+(/\S*) [NC]
    RewriteRule ^ https://%1%2 [R=301,L,NE]

    # Sitemap alias.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Collapse /index and /index.php to the site root — the home page should
    # live at "/" only, not "/index". Must run before the generic .php rule
    # below so "/index.php" doesn't first become "/index".
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
    RewriteRule ^ / [R=301,L,NE]

    # Redirect direct .php requests to extensionless URL (canonical).
    # Only on safe methods — a 301 drops the request body and converts POST
    # to GET, which would silently break form submissions (reserve, cancel…).
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+([^\s?]*?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Strip a trailing slash from page URLs (old WordPress links like
    # /rezervace/ still indexed by Google). Serving the page at /rezervace/
    # would make relative URLs (style.css, assets/…) resolve under
    # /rezervace/ and 404, so the page renders without CSS.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/+$ /$1 [R=301,L,NE]

    # Internally map extensionless URL to .php file when it exists.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

# Serve plain-text files as UTF-8 so Czech diacritics render correctly
# instead of being decoded with the server's default (often ISO-8859-1).
AddCharset UTF-8 .txt

ErrorDocument 404 /404.php
